{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mod_visuallearning:animated_scene:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["type","version","title","description","representation","viewBox","aspectRatio","style","layers","paths","gradients","objects","stages","accessibility"],
  "properties": {
    "type":{"enum":["animated_scene"]},
    "version":{"enum":["1.0"]},
    "title":{"$ref":"#/$defs/shortText"},
    "description":{"$ref":"#/$defs/longText"},
    "representation":{"enum":["schematic","proportional","metaphor"]},
    "viewBox":{"type":"array","items":{"$ref":"#/$defs/coordinate"},"minItems":4,"maxItems":4},
    "aspectRatio":{"enum":["meet","slice"]},
    "style":{"type":"object","additionalProperties":false,"required":["reference","artDirection","background","foreground","accent","font","fontSize","strokeWidth"],"properties":{"reference":{"$ref":"#/$defs/shortText"},"artDirection":{"$ref":"#/$defs/longText"},"background":{"$ref":"#/$defs/colour"},"foreground":{"$ref":"#/$defs/colour"},"accent":{"$ref":"#/$defs/colour"},"font":{"enum":["sans-serif","serif","monospace"]},"fontSize":{"type":"number","minimum":10,"maximum":72},"strokeWidth":{"type":"number","minimum":0,"maximum":16}}},
    "layers":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["id","label"],"properties":{"id":{"$ref":"#/$defs/id"},"label":{"$ref":"#/$defs/shortText"}}}},
    "paths":{"type":"array","maxItems":32,"items":{"type":"object","additionalProperties":false,"required":["id","segments"],"properties":{"id":{"$ref":"#/$defs/id"},"segments":{"type":"array","minItems":2,"maxItems":128,"items":{"type":"object","additionalProperties":false,"required":["command","values"],"properties":{"command":{"enum":["M","L","Q","C","Z"]},"values":{"type":"array","maxItems":6,"items":{"$ref":"#/$defs/coordinate"}}}}}}}},
    "gradients":{"type":"array","maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["id","kind","stops"],"properties":{"id":{"$ref":"#/$defs/id"},"kind":{"enum":["linear","radial"]},"stops":{"type":"array","minItems":2,"maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["offset","colour","opacity"],"properties":{"offset":{"$ref":"#/$defs/unit"},"colour":{"$ref":"#/$defs/colour"},"opacity":{"$ref":"#/$defs/unit"}}}}}}},
    "objects":{"type":"array","minItems":1,"maxItems":160,"items":{"$ref":"#/$defs/object"}},
    "stages":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["title","description","durationMs","actions"],"properties":{"title":{"$ref":"#/$defs/shortText"},"description":{"$ref":"#/$defs/longText"},"durationMs":{"type":"integer","minimum":1,"maximum":120000},"actions":{"type":"array","maxItems":96,"items":{"$ref":"#/$defs/action"}}}}},
    "accessibility":{"type":"object","additionalProperties":false,"required":["summary","reducedMotion","stageDescriptions"],"properties":{"summary":{"$ref":"#/$defs/longText"},"reducedMotion":{"enum":["stage-final"]},"stageDescriptions":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/longText"}}}}
  },
  "$defs":{
    "id":{"type":"string","minLength":1,"maxLength":48,"pattern":"^[A-Za-z][A-Za-z0-9_-]*$"},
    "shortText":{"type":"string","minLength":1,"maxLength":180},
    "longText":{"type":"string","minLength":1,"maxLength":2400},
    "coordinate":{"type":"number","minimum":-10000,"maximum":10000},
    "unit":{"type":"number","minimum":0,"maximum":1},
    "colour":{"type":"string","pattern":"^#[0-9a-fA-F]{6}$","minLength":7,"maxLength":7},
    "paint":{"anyOf":[{"$ref":"#/$defs/colour"},{"enum":["none"]}]},
    "point":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/coordinate"}},
    "points":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/point"}},
    "empty":{"type":"object","additionalProperties":false,"properties":{}},
    "xy":{"type":"object","additionalProperties":false,"required":["x","y"],"properties":{"x":{"$ref":"#/$defs/coordinate"},"y":{"$ref":"#/$defs/coordinate"}}},
    "scale":{"type":"object","additionalProperties":false,"required":["scaleX","scaleY"],"properties":{"scaleX":{"type":"number","minimum":0.01,"maximum":20},"scaleY":{"type":"number","minimum":0.01,"maximum":20}}},
    "opacity":{"type":"object","additionalProperties":false,"required":["opacity"],"properties":{"opacity":{"$ref":"#/$defs/unit"}}},
    "visibility":{"type":"object","additionalProperties":false,"required":["visible","opacity"],"properties":{"visible":{"type":"boolean"},"opacity":{"$ref":"#/$defs/unit"}}},
    "positions":{"type":"object","additionalProperties":false,"required":["positions"],"properties":{"positions":{"$ref":"#/$defs/points"}}},
    "state":{"type":"object","additionalProperties":false,"properties":{"x":{"$ref":"#/$defs/coordinate"},"y":{"$ref":"#/$defs/coordinate"},"rotation":{"type":"number","minimum":-36000,"maximum":36000},"scaleX":{"type":"number","minimum":0.01,"maximum":20},"scaleY":{"type":"number","minimum":0.01,"maximum":20},"opacity":{"$ref":"#/$defs/unit"},"visible":{"type":"boolean"},"fill":{"$ref":"#/$defs/paint"},"stroke":{"$ref":"#/$defs/paint"},"strokeWidth":{"type":"number","minimum":0,"maximum":16},"value":{"type":"number","minimum":-1000000000,"maximum":1000000000},"connected":{"type":"boolean"},"drawProgress":{"$ref":"#/$defs/unit"},"flowOffset":{"$ref":"#/$defs/coordinate"}}},
    "geometry":{"type":"object","additionalProperties":false,"properties":{"width":{"type":"number","minimum":0.1,"maximum":10000},"height":{"type":"number","minimum":0.1,"maximum":10000},"radius":{"type":"number","minimum":0.1,"maximum":10000},"rx":{"type":"number","minimum":0.1,"maximum":10000},"ry":{"type":"number","minimum":0.1,"maximum":10000},"x2":{"$ref":"#/$defs/coordinate"},"y2":{"$ref":"#/$defs/coordinate"},"points":{"$ref":"#/$defs/points"},"path":{"$ref":"#/$defs/id"},"teeth":{"type":"integer","minimum":6,"maximum":64},"from":{"$ref":"#/$defs/id"},"to":{"$ref":"#/$defs/id"}}},
    "object":{"type":"object","additionalProperties":false,"required":["id","kind","role","layer","label","geometry","initial"],"properties":{"id":{"$ref":"#/$defs/id"},"kind":{"enum":["group","rect","circle","ellipse","line","arrow","polygon","path","text","gear","particles","connector"]},"role":{"enum":["draw","clip","mask"]},"layer":{"$ref":"#/$defs/id"},"label":{"type":"string","maxLength":180},"parent":{"$ref":"#/$defs/id"},"clip":{"$ref":"#/$defs/id"},"mask":{"$ref":"#/$defs/id"},"gradient":{"$ref":"#/$defs/id"},"geometry":{"$ref":"#/$defs/geometry"},"initial":{"$ref":"#/$defs/state"}}},
    "action":{"type":"object","additionalProperties":false,"required":["target","startMs","durationMs","easing","operation"],"properties":{"target":{"anyOf":[{"$ref":"#/$defs/id"},{"enum":["@camera"]}]},"startMs":{"type":"integer","minimum":0,"maximum":120000},"durationMs":{"type":"integer","minimum":1,"maximum":120000},"easing":{"enum":["linear","smooth","ease-in","ease-out"]},"operation":{"anyOf":[{"$ref":"#/$defs/move"},{"$ref":"#/$defs/rotate"},{"$ref":"#/$defs/scaleAction"},{"$ref":"#/$defs/fade"},{"$ref":"#/$defs/highlight"},{"$ref":"#/$defs/draw_path"},{"$ref":"#/$defs/follow_path"},{"$ref":"#/$defs/emit_particles"},{"$ref":"#/$defs/merge_particles"},{"$ref":"#/$defs/split_particles"},{"$ref":"#/$defs/morph"},{"$ref":"#/$defs/reveal"},{"$ref":"#/$defs/hide"},{"$ref":"#/$defs/flow"},{"$ref":"#/$defs/pulse"},{"$ref":"#/$defs/zoom"},{"$ref":"#/$defs/pan"},{"$ref":"#/$defs/change_colour"},{"$ref":"#/$defs/change_value"},{"$ref":"#/$defs/connect"},{"$ref":"#/$defs/disconnect"}]}}},
    "move":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["move"]},"params":{"$ref":"#/$defs/empty"},"final":{"$ref":"#/$defs/xy"}}},
    "rotate":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["rotate"]},"params":{"$ref":"#/$defs/empty"},"final":{"type":"object","additionalProperties":false,"required":["rotation"],"properties":{"rotation":{"type":"number","minimum":-36000,"maximum":36000}}}}},
    "scaleAction":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["scale"]},"params":{"$ref":"#/$defs/empty"},"final":{"$ref":"#/$defs/scale"}}},
    "fade":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["fade"]},"params":{"$ref":"#/$defs/empty"},"final":{"$ref":"#/$defs/opacity"}}},
    "highlight":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["highlight"]},"params":{"type":"object","additionalProperties":false,"required":["colour","width"],"properties":{"colour":{"$ref":"#/$defs/colour"},"width":{"type":"number","minimum":0,"maximum":16}}},"final":{"type":"object","additionalProperties":false,"required":["stroke","strokeWidth"],"properties":{"stroke":{"$ref":"#/$defs/paint"},"strokeWidth":{"type":"number","minimum":0,"maximum":16}}}}},
    "draw_path":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["draw_path"]},"params":{"$ref":"#/$defs/empty"},"final":{"type":"object","additionalProperties":false,"required":["drawProgress"],"properties":{"drawProgress":{"$ref":"#/$defs/unit"}}}}},
    "follow_path":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["follow_path"]},"params":{"type":"object","additionalProperties":false,"required":["path","from","to","orient"],"properties":{"path":{"$ref":"#/$defs/id"},"from":{"$ref":"#/$defs/unit"},"to":{"$ref":"#/$defs/unit"},"orient":{"type":"boolean"}}},"final":{"type":"object","additionalProperties":false,"required":["x","y","rotation"],"properties":{"x":{"$ref":"#/$defs/coordinate"},"y":{"$ref":"#/$defs/coordinate"},"rotation":{"type":"number","minimum":-36000,"maximum":36000}}}}},
    "emit_particles":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["emit_particles"]},"params":{"type":"object","additionalProperties":false,"required":["origin","stagger"],"properties":{"origin":{"$ref":"#/$defs/point"},"stagger":{"type":"number","minimum":0,"maximum":0.9}}},"final":{"$ref":"#/$defs/positions"}}},
    "merge_particles":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["merge_particles"]},"params":{"$ref":"#/$defs/empty"},"final":{"type":"object","additionalProperties":false,"required":["point"],"properties":{"point":{"$ref":"#/$defs/point"}}}}},
    "split_particles":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["split_particles"]},"params":{"$ref":"#/$defs/empty"},"final":{"$ref":"#/$defs/positions"}}},
    "morph":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["morph"]},"params":{"$ref":"#/$defs/empty"},"final":{"type":"object","additionalProperties":false,"required":["path"],"properties":{"path":{"$ref":"#/$defs/id"}}}}},
    "reveal":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["reveal"]},"params":{"$ref":"#/$defs/empty"},"final":{"$ref":"#/$defs/visibility"}}},
    "hide":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["hide"]},"params":{"$ref":"#/$defs/empty"},"final":{"$ref":"#/$defs/visibility"}}},
    "flow":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["flow"]},"params":{"type":"object","additionalProperties":false,"required":["cycles","alternate"],"properties":{"cycles":{"type":"integer","minimum":1,"maximum":32},"alternate":{"type":"boolean"}}},"final":{"type":"object","additionalProperties":false,"required":["flowOffset"],"properties":{"flowOffset":{"$ref":"#/$defs/coordinate"}}}}},
    "pulse":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["pulse"]},"params":{"type":"object","additionalProperties":false,"required":["amplitude","cycles"],"properties":{"amplitude":{"type":"number","minimum":0,"maximum":0.9},"cycles":{"type":"integer","minimum":1,"maximum":32}}},"final":{"$ref":"#/$defs/scale"}}},
    "zoom":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["zoom"]},"params":{"$ref":"#/$defs/empty"},"final":{"type":"object","additionalProperties":false,"required":["zoom"],"properties":{"zoom":{"type":"number","minimum":0.1,"maximum":10}}}}},
    "pan":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["pan"]},"params":{"$ref":"#/$defs/empty"},"final":{"$ref":"#/$defs/xy"}}},
    "change_colour":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["change_colour"]},"params":{"$ref":"#/$defs/empty"},"final":{"type":"object","additionalProperties":false,"required":["fill"],"properties":{"fill":{"$ref":"#/$defs/colour"}}}}},
    "change_value":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["change_value"]},"params":{"$ref":"#/$defs/empty"},"final":{"type":"object","additionalProperties":false,"required":["value"],"properties":{"value":{"type":"number","minimum":-1000000000,"maximum":1000000000}}}}},
    "connect":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["connect"]},"params":{"$ref":"#/$defs/empty"},"final":{"type":"object","additionalProperties":false,"required":["connected"],"properties":{"connected":{"enum":[true]}}}}},
    "disconnect":{"type":"object","additionalProperties":false,"required":["type","params","final"],"properties":{"type":{"enum":["disconnect"]},"params":{"$ref":"#/$defs/empty"},"final":{"type":"object","additionalProperties":false,"required":["connected"],"properties":{"connected":{"enum":[false]}}}}}
  }
}
